// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  output        = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  url          String?
  isActive     Boolean   @default(false)
  orderEndTime DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  menuItems MenuItem[]
  orders    Order[]
}

model MenuItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  price       Int
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @db.ObjectId

  orderItems   OrderItem[]
  // New relation for MenuItem to MenuItemOptionGroup
  optionGroups MenuItemOptionGroup[]
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  comments   OrderComment[]
}

model Order {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId String     @db.ObjectId
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  totalPrice   Int?
  status       String?

  orderItems OrderItem[]
  comments   OrderComment[]
}

model OrderItem {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String   @db.ObjectId
  order           Order    @relation(fields: [orderId], references: [id])
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id])
  menuItemId      String   @db.ObjectId
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id])
  itemNameAtOrder String
  priceAtOrder    Int
  quantity        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OrderComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  orderId   String   @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id])
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OptionGroup {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String // Renamed 'value' to 'name' for clarity as it represents the group name (e.g., 'friet opties')
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options              Option[]
  menuItemOptionGroups MenuItemOptionGroup[]
}

model Option {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  optionGroupId String      @db.ObjectId
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id])
  value         String // e.g., 'zonder zout', 'tomaten ketchup'
  price         Int         @default(0) // Default price to 0 if not specified
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model MenuItemOptionGroup {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  menuItemId    String      @db.ObjectId
  menuItem      MenuItem    @relation(fields: [menuItemId], references: [id])
  optionGroupId String      @db.ObjectId
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([menuItemId, optionGroupId]) // Ensures a menu item can only be associated with an option group once
}
